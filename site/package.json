{
  "name": "beadz-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build-whitepaper.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check && tsc --noEmit",
    "brand:build": "node brand/build.mjs",
    "tokenlist:build": "node scripts/build-tokenlist.mjs",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.astro\"",
    "lint:js": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:css && npm run lint:js && npm run format:check",
    "lint:fix": "prettier --write . && eslint --fix . && stylelint --fix \"src/**/*.css\" \"src/**/*.astro\" && prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/roboto-serif": "^5.0.0",
    "@half-built/astro": "0.15.0",
    "@half-built/css": "0.15.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@half-built/tooling": "0.15.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "html-validate": "^9.7.1",
    "jsdom": "^25.0.0",
    "opentype.js": "^1.3.4",
    "png-to-ico": "^2.1.8",
    "postcss-custom-media": "^12.0.3",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.33.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.0.0"
  }
}
