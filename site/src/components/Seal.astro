---
import { STATS, GENESIS_BEADS } from "../config";
---

<div
  class="seal"
  role="img"
  tabindex="0"
  aria-label={`Reserve verified seal: ${STATS.collateralization} reserved. Reverse shows the BEADZ token.`}
>
  <div class="seal-inner">
    <div class="seal-face seal-front">
      <div class="seal-big">{STATS.collateralization}</div>
      <div class="seal-small">RESERVED</div>
      <div class="seal-tiny seal-muted">OFFICE OF THE<br />VAULT KEEPER</div>
    </div>
    <div class="seal-face seal-back">
      <div class="seal-big seal-mark">BEADZ</div>
      <div class="seal-small">· {GENESIS_BEADS.toLocaleString("en-US")} ·</div>
      <div class="seal-tiny">ERC-20 · BASE</div>
    </div>
  </div>
</div>

<style>
  /* A wax-seal stamp that flips on hover or focus to show the token on
     its reverse. Inline by default, centered in the column under the
     signature.
     The focus ring is the system's; never outline: none. Wide
     placement is in the media query at the end. */
  .seal {
    position: relative;
    width: 132px;
    height: 132px;
    margin: clamp(32px, 5vw, 56px) auto 0;
    perspective: 700px;
    border-radius: 50%;
  }

  .seal-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .seal:hover .seal-inner,
  .seal:focus-visible .seal-inner { transform: rotateY(180deg); }

  .seal-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: var(--stroke) solid var(--accent-1-ink);
    border-radius: 50%;
    box-shadow: var(--shadow);
    backface-visibility: hidden;
  }

  .seal-front {
    color: var(--accent-1-ink);
    background: var(--surface);
  }

  .seal-back {
    color: var(--accent-1);
    background: var(--black-900);
    transform: rotateY(180deg);
  }

  .seal-big { font-size: 20px; font-weight: 700; }
  .seal-mark { font-size: 25px; letter-spacing: 0.04em; }
  .seal-small { margin-top: 4px; font-size: 8px; letter-spacing: 0.16em; }
  .seal-tiny { margin-top: 4px; font-size: 7px; letter-spacing: 0.1em; }
  .seal-muted { color: var(--ink-muted); }

  /* 1380 shell + 2 x (30 offset + 132 seal + 30 air) = 1764; 1780 adds
     margin. Only here does the seal leave the flow and pin to the left
     gutter, where it covers no content or footer link, so nothing
     reserves room for it. It keeps 40px from the content's left edge on
     very wide windows rather than drifting to the window edge, and never
     comes closer than 30px to the window edge. */
  @media (min-width: 1780px) {
    .seal {
      position: fixed;
      bottom: 30px;
      left: max(30px, calc((100vw - var(--shell-max)) / 2 - 132px - 40px));
      z-index: var(--z-scroll-top);
      margin: 0;
    }

    /* The seal travels down the gutter with the page: from the top-left
       corner (30px inset) at the top of the scroll to the 30px bottom
       inset at the end, linear between. The gutter sits outside the
       shell, so it clears the header's frame at any height. A
       scroll timeline, so no script. Without one, or with reduced
       motion, it keeps the static bottom placement above. The end
       never rises above the start on a short window. */
    @supports (animation-timeline: scroll()) {
      .seal {
        animation: beadz-seal-travel linear both;
        animation-timeline: scroll(root block);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .seal { animation: none; }
    }
  }

  @keyframes beadz-seal-travel {
    from { top: 30px; }
    to { top: max(30px, calc(100% - 30px - 132px)); }
  }
</style>
