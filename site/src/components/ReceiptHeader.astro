---
interface Props {
  eyebrow: string;
  page?: string;
}

const { eyebrow, page } = Astro.props;
---

{/* The depository-receipt header: eyebrow, the serif h1 with the accent
   italic, and the page's opening paragraphs in the default slot. The
   page's one h1 (the header wordmark is a <p>). */}

<header class="receipt">
  <p class="receipt-eyebrow micro-label">{eyebrow}</p>
  <h1 class="receipt-title">The Bead <em>Reserve</em>{page && ` : ${page}`}</h1>
  <slot />
</header>

<style>
  /* Room above the eyebrow so it does not start flush under the site
     header (owner call 2026-10-08). */
  .receipt { margin: clamp(24px, 4vw, 48px) 0 clamp(40px, 5vw, 64px); }

  .receipt-eyebrow {
    margin: 0 0 8px;
    color: var(--accent-1-ink);
    text-transform: uppercase;
  }

  /* One step under the header wordmark (xl), which it repeats. */
  .receipt-title {
    margin: 0 0 12px;
    font-family: var(--beadz-font-display);
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: 1.05;
  }

  .receipt-title em { color: var(--accent-1-ink); }
  .receipt :global(p:not(.receipt-eyebrow)) { color: var(--ink-muted); }
</style>
