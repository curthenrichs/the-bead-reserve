---
import Layout from "../layouts/Layout.astro";
import ReceiptHeader from "../components/ReceiptHeader.astro";
import StatLedger from "@half-built/astro/components/StatLedger.astro";
import { STATS } from "../config";
import Seal from "../components/Seal.astro";
import Disclaimers from "../components/Disclaimers.astro";
import CameraMonitor from "../components/CameraMonitor.astro";
import ClaimPanel from "../components/ClaimPanel.astro";
import RedeemPanel from "../components/RedeemPanel.astro";
import SubscribeBand from "../components/SubscribeBand.astro";
---

<Layout title="The Bead Reserve : Claim Office">
  <main>
    <ReceiptHeader eyebrow="Depository Receipt · Office of the Vault Keeper">
      <p>
        The Bead Reserve maintains <b>full physical collateralization</b> of
        every outstanding BEADZ against a monitored reserve of glass seed beads,
        held in a sealed jar and observed continuously by camera. Supply was
        minted once at genesis and fixed permanently. One (1) BEADZ is entitled
        to one (1)
        bead.<sup class="note-ref"
          ><a href="#note-1" aria-label="Note 1">1</a></sup
        >
      </p>
      <p class="receipt-link">
        <a href="/whitepaper.pdf" target="_blank" rel="noopener"
          >The full terms are set out in the whitepaper&nbsp;↗</a
        >
      </p>
    </ReceiptHeader>
    <StatLedger
      label="Reserve figures"
      items={[
        { label: "Physical Reserve", value: STATS.reserve },
        { label: "Outstanding BEADZ", value: STATS.outstanding },
        {
          label: "Collateralization",
          value: STATS.collateralization,
          accent: true,
        },
      ]}
    />
    <ClaimPanel />
    <RedeemPanel />
    {/* Section III: the monitor under its numbered heading, with the
       way to the full attestation record on /fault-cam/. */}
    <section class="panel observation" aria-labelledby="observation-heading">
      <h2 id="observation-heading">III. Observation of the Reserve</h2>
      <CameraMonitor />
      <p class="observation-link">
        The attestation record for the current frame is kept at
        <a href="/fault-cam/">the Fault Cam</a>.
      </p>
    </section>
    <Disclaimers />
    {/* The seal has two placements. From 1780px it floats fixed in the
       left gutter and takes no room here. Below that it sits in the flow
       under the signature. */}
    <Seal />
    {/* A very large pause after the Vault Keeper signs, before the
       newsletter (owner call 2026-10-08): the receipt ends, then the
       bridge back to the workshop. Scales down on phones. */}
    <div class="subscribe-gap">
      <SubscribeBand />
    </div>
  </main>
</Layout>

<style>
  /* Under its heading the monitor sits closer than its own default
     margins, the way the panels' contents do. */
  .observation :global(.camera-monitor),
  .observation :global(.cm-slot) {
    margin: 16px auto;
  }

  .observation-link { text-align: center; }

  .subscribe-gap {
    margin-top: clamp(96px, 14vw, 180px);
    margin-bottom: clamp(32px, 5vw, 64px);
  }
</style>
