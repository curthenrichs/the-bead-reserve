---
import Layout from "../layouts/Layout.astro";
import ReceiptHeader from "../components/ReceiptHeader.astro";
import CameraMonitor from "../components/CameraMonitor.astro";
import { DEVICE_PUBKEY } from "../config";
import {
  recordFor,
  VERDICT_TAG,
  VERDICT_TEXT,
  VERDICT_TONE,
} from "../scripts/attestation";
import { DARK } from "../scripts/camera-state";

const rec = recordFor(DARK);
---

<Layout
  title="The Bead Reserve : Fault Cam"
  description="The reserve under camera observation, with the attestation record for the latest frame and a signature check that runs in the visitor's browser."
>
  {/* The record is server-rendered dark, like the monitor, so with no
     Worker or no JavaScript the page is honest. attestation-record.ts
     repaints it from the monitor's poll. */}
  <main>
    <ReceiptHeader eyebrow="Reserve Monitoring · Fault Cam 01" page="Fault Cam">
      <p>
        Fault Cam 01 keeps the reserve under observation and files one signed
        still per hour. The latest frame is shown below with its attestation
        record. Any party may check the record against the published device key.
      </p>
    </ReceiptHeader>

    <CameraMonitor wide />

    {/* The record as a certificate card: the package bracket frame,
       the title in the display serif, the fields as a receipt table
       with the verdict stamped under its closing rule. data-tone picks
       the stamp's ink; attestation-record.ts keeps it in step. */}
    <section
      class="fc-section fc-cert bracket-frame"
      aria-labelledby="record-heading"
      data-attestation
      data-status={rec.status}
      data-tone={VERDICT_TONE.dark}
    >
      <h2 id="record-heading" class="fc-cert-title">
        Certificate of Attestation
      </h2>
      <table class="fc-record" aria-labelledby="record-heading">
        <tbody>
          <tr>
            <th scope="row">Frame number</th>
            <td data-at="counter">{rec.counter}</td>
          </tr>
          <tr>
            <th scope="row">Captured (UTC)</th>
            <td data-at="captured">{rec.captured}</td>
          </tr>
          <tr>
            <th scope="row">SHA-256</th>
            <td data-at="sha256">{rec.sha256}</td>
          </tr>
          <tr>
            <th scope="row">Signature</th>
            <td data-at="sig">{rec.sig}</td>
          </tr>
          <tr>
            <th scope="row">Device key (Ed25519)</th>
            <td>{DEVICE_PUBKEY}</td>
          </tr>
          <tr>
            <th scope="row">Status</th>
            <td>
              <span
                class="fc-tag fc-status boxed-label micro-label"
                data-at="status"
              >
                {rec.status}
              </span>
            </td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Verification</th>
            <td>
              {/* The stamp is the short form for the eye; the sentence
                 beside it is the live region, so a screen reader hears
                 what it heard before the card. */}
              <span
                class="fc-tag fc-stamp boxed-label micro-label"
                data-at="verdict-tag"
                aria-hidden="true"
                >{VERDICT_TAG.dark}</span
              >
              <span class="fc-verdict" data-at="verdict" aria-live="polite"
                >{VERDICT_TEXT.dark}</span
              >
            </td>
          </tr>
        </tfoot>
      </table>
    </section>

    <section class="fc-section" aria-labelledby="signing-heading">
      <h2 id="signing-heading" class="fc-heading micro-label">
        How frames are signed
      </h2>
      <p>
        Once an hour the camera device takes a still of the reserve. The device
        strips the EXIF metadata and crops the image to the jar before anything
        else is done with it. It then computes the SHA-256 hash of the image and
        signs that hash with an Ed25519 key that does not leave the device. The
        signed frame goes to the reserve's ingest server, which checks the hash
        and the signature against the published key and does not store a frame
        that fails. Anyone holding the device key above can repeat the check.
        This page repeats it in your browser where the browser supports Ed25519.
      </p>
    </section>
  </main>
</Layout>

<script>
  import { mountAttestationRecord } from "../scripts/attestation-record";
  mountAttestationRecord(document);
</script>

<style>
  .fc-section { margin: 0 0 40px; }

  /* The certificate sizes to its content and centers. Its cap is one
     64-character hash plus its label, so SHA-256 and the device key sit
     on one line and the 128-character signature wraps to two. A data
     table, not prose; at phone width every value wraps inside it. */
  .fc-cert {
    width: fit-content;
    max-width: min(100%, 52rem);
    margin-inline: auto;
  }

  .fc-heading {
    margin: 0 0 12px;
    font-size: var(--font-size-xs);
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  /* The receipt heading's serif, one step smaller than the h1's. */
  .fc-cert-title {
    margin: 0 0 16px;
    font-family: var(--beadz-font-display);
    font-size: var(--font-size-md);
    font-weight: 600;
    line-height: 1.1;
  }

  /* A small data table sized to the card, not a prose measure. Values
     wrap anywhere so the hex never widens the page at phone width. */
  .fc-record {
    width: auto;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .fc-record th,
  .fc-record td {
    padding: 10px 0;
    border-bottom: 1px solid var(--hairline);
    vertical-align: baseline;
  }

  .fc-record th {
    width: 1%;
    padding-right: 20px;
    color: var(--ink-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fc-record td {
    text-align: right;
    overflow-wrap: anywhere;
  }

  .fc-record tbody tr:last-child > * { border-bottom: 0; }

  /* The verdict sits under a full-width rule, like a receipt's total. */
  .fc-record tfoot th,
  .fc-record tfoot td {
    padding-top: 16px;
    border-top: var(--stroke) solid var(--rule);
    border-bottom: 0;
  }

  .fc-tag {
    display: inline-block;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .fc-status { padding: 0 6px; }

  .fc-stamp {
    padding: 4px 10px;
    font-size: var(--font-size-sm);
    color: var(--ink-muted);
    border-color: currentcolor;
  }

  .fc-cert[data-tone="verified"] .fc-stamp { color: var(--accent-1-ink); }
  .fc-cert[data-tone="failed"] .fc-stamp { color: var(--error-ink); }

  .fc-verdict {
    display: block;
    margin-top: 8px;
  }

  @media (--bp-phone) {
    .fc-record th { white-space: normal; padding-right: 12px; }
  }
</style>
