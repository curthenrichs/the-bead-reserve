---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="The Bead Reserve : Page Not Found"
  description="The Bead Reserve holds no record at this address."
  noindex
>
  <main>
    <article class="policy bracket-frame">
      <h1>Page not found</h1>
      <div class="prose">
        <p>
          The Reserve holds no record at this address. The page may have moved,
          or the link may be mistyped.
        </p>
        <p><a href="/">Return to the Reserve</a></p>
      </div>
    </article>
  </main>
</Layout>
